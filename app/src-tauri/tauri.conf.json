{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Control Center",
  "version": "1.0.0",
  "identifier": "dev.chamsoudine.controlcenter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Control Center",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "label": "main"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Centre de contrôle local-first pour vos applications",
    "longDescription": "Gérez applications, clés API, déploiements et licences depuis votre appareil, chiffré de bout en bout.",
    "createUpdaterArtifacts": false,
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "publisher": "Control Center",
    "copyright": "© Control Center contributors"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/chamsoudine-dev/Logiciel-/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
